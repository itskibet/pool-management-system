APP_ENV=local
FRONTEND_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pool_management
DB_USERNAME=root
DB_PASSWORD=

DEFAULT_ORGANIZATION_ID=1

# Used only once to create the first owner account. Set a long random value locally.
BOOTSTRAP_KEY=change-this-long-random-value

PAYHERO_BASE_URL=https://api.payhero.africa
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_ACCOUNT_ID=
PAYHERO_NETWORK_CODE=
PAYHERO_MERCHANT_FEE=0
PAYHERO_PAYBILL_NUMBER=
PAYHERO_PAYBILL_PREFIX=
PAYHERO_CALLBACK_URL=
# Generate 32 random bytes (base64url) and append it to /api/payhero/callback/<secret> in the callback URL.
PAYHERO_CALLBACK_SECRET=

MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=poolpilot-worker
